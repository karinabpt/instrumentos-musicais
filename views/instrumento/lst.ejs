<!DOCTYPE html>
<html lang="pt-br">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lista de Instrumentos</title>
</head>

<body>
    <h2>Lista de Instrumentos</h2>
    <a href="/instrumento/add">Cadastrar novo instrumento</a>
    <% if (instrumentos.length===0) { %>
        <p>Nenhum instrumento cadastrado. Clique no link acima para cadastrar o primeiro.</p>
        <% } else { %>
            <table border="1" cellpadding="6">
                <tr>
                    <th>Nome</th>
                    <th>Fabricante</th>
                    <th>Preço</th>
                    <th>Tipo</th>
                </tr>
                <% instrumentos.forEach(i=> { %>
                    <tr>
                        <td>
                            <%= i.nome %>
                        </td>
                        <td>
                            <%= i.fabricante %>
                        </td>
                        <td>R$ <%= i.preco %>
                        </td>
                        <td>
                            <%= i.tipo %>
                        </td>
                    </tr>
                    <% }) %>
            </table>
            <% } %>
</body>

</html>